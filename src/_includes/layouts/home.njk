{% extends "layouts/base.njk" %}
{%- set h = home[lang] -%}
{%- set p = work.projects[0] -%}
{%- set pd = p[lang] -%}

{% block head %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Organization",
  "@id":"{{ site.url }}/#org",
  "name":"Texas Digital Co.",
  "url":"{{ site.url }}",
  "email":"{{ site.email }}",
  "description":"{{ h.metaDesc }}",
  "knowsLanguage":["en","es"],
  "makesOffer":[{% for s in services %}{
    "@type":"Offer",
    "itemOffered":{"@type":"Service","name":"{{ s[lang].name }}","description":"{{ s[lang].tagline }}"}
  }{{ "," if not loop.last }}{% endfor %}]
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"FAQPage",
  "mainEntity":[{% for f in h.faqs %}{
    "@type":"Question","name":{{ f.q | dump | safe }},
    "acceptedAnswer":{"@type":"Answer","text":{{ f.a | dump | safe }}}
  }{{ "," if not loop.last }}{% endfor %}]
}
</script>
{% endblock %}

{% block content %}

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <span class="eyebrow">{{ h.eyebrow }}</span>
        <h1>{{ h.h1 }}</h1>
        <p class="lede">{{ h.lede }}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="{{ startUrl }}">{{ t.book }}</a>
          <a class="btn btn--outline-light" href="#services">{{ t.allServices }}</a>
        </div>
      </div>
      <ul class="hero-facts">
        {%- for f in h.facts %}
        <li class="hero-fact">{{ icon("check") }}<span>{{ f.text }}</span></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section" id="services">
  <div class="container">
    <div class="sec-head sec-head--split reveal">
      <div>
        <span class="eyebrow">{{ h.servicesEyebrow }}</span>
        <h2>{{ h.servicesH2 }}</h2>
      </div>
      <p>{{ h.servicesP }}</p>
    </div>

    <div class="index reveal">
      {%- for s in services %}
      {%- set d = s[lang] %}
      <a class="index-row" href="{{ '/es/servicios/' + s.slugEs + '/' if lang == 'es' else '/services/' + s.slug + '/' }}">
        <span class="index-num">{{ "0" + (loop.index | string) }}</span>
        <span class="index-name">{{ d.name }}</span>
        <span class="index-desc">{{ d.tagline }}</span>
        <span class="index-price">{{ d.price }}<small>{{ d.priceNote }}</small></span>
        <span class="index-arrow">{{ icon("arrow") }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--dark" id="terms">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{{ h.whyEyebrow }}</span>
      <h2>{{ h.whyH2 }}</h2>
    </div>
    <div class="terms reveal">
      {%- for w in h.why %}
      <div class="term">
        <span class="term-num">{{ "0" + (loop.index | string) }}</span>
        <h3>{{ w.h }}</h3>
        <p>{{ w.p }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--wash">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{{ 'Proyectos' if lang == 'es' else 'Work' }}</span>
      <h2>{{ 'Trabajo que puedes abrir ahora mismo.' if lang == 'es' else 'Work you can open right now.' }}</h2>
    </div>

    <article class="project reveal">
      <div class="project-media">
        {%- if p.image %}
        <img src="{{ p.image }}" alt="{{ pd.name }}" loading="lazy" width="1200" height="750">
        {%- else %}
        <div class="project-fallback">
          <span class="pf-kick">{{ pd.kicker }}</span>
          <span class="pf-dom">{{ p.domain }}</span>
          <span class="pf-live"><span class="pf-dot"></span>{{ 'En vivo' if lang == 'es' else 'Live' }}</span>
        </div>
        {%- endif %}
      </div>
      <div>
        <span class="project-kicker">{{ pd.kicker }}</span>
        <h2>{{ pd.name }}</h2>
        <p class="project-summary">{{ pd.summary }}</p>
        <div class="tags">
          {%- for tag in p.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="{{ p.url }}" target="_blank" rel="noopener">{{ pd.visit }}</a>
          <a class="btn btn--ghost" href="{{ workUrl }}">{{ t.seeWork }}</a>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section" id="process">
  <div class="container">
    <div class="sec-head sec-head--split reveal">
      <div>
        <span class="eyebrow">{{ h.processEyebrow }}</span>
        <h2>{{ h.processH2 }}</h2>
      </div>
    </div>
    <div class="steps reveal">
      {%- for st in h.process %}
      <div class="step">
        <span class="step-num">{{ "0" + (loop.index | string) }}</span>
        <h3>{{ st.h }}</h3>
        <p>{{ st.p }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--wash" id="pricing">
  <div class="container">
    <div class="sec-head sec-head--split reveal">
      <div>
        <span class="eyebrow">{{ h.pricingEyebrow }}</span>
        <h2>{{ h.pricingH2 }}</h2>
      </div>
      <p>{{ h.pricingP }}</p>
    </div>

    <div class="table-scroll reveal">
      <table class="price-table">
        <thead>
          <tr><th scope="col">{{ h.thService }}</th><th scope="col">{{ h.thWhat }}</th><th scope="col" class="col-price">{{ h.thPrice }}</th></tr>
        </thead>
        <tbody>
          {%- for s in services %}
          {%- set d = s[lang] %}
          <tr>
            <th scope="row"><a href="{{ '/es/servicios/' + s.slugEs + '/' if lang == 'es' else '/services/' + s.slug + '/' }}">{{ d.name }}</a></th>
            <td>{{ d.tagline }}</td>
            <td class="col-price">{{ d.price }}<small>{{ d.priceNote }}</small></td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    <p class="price-cap">{{ h.pricingCaption }}</p>
  </div>
</section>

<section class="section section--dark" id="check">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{{ h.analyzer.eyebrow }}</span>
      <h2>{{ h.analyzer.h2 }}</h2>
      <p>{{ h.analyzer.p }}</p>
    </div>

    <form class="analyzer-form reveal" id="psiForm"
          data-running="{{ h.analyzer.running }}"
          data-invalid="{{ h.analyzer.invalid }}"
          data-failed="{{ h.analyzer.failed }}"
          data-resultfor="{{ h.analyzer.resultFor }}"
          data-labels="{{ h.analyzer.cats | dump | escape }}">
      <label class="hp" for="psiUrl">{{ h.analyzer.label }}</label>
      <input class="input" type="text" id="psiUrl" name="psiUrl" inputmode="url" autocomplete="url"
             placeholder="{{ h.analyzer.placeholder }}" aria-label="{{ h.analyzer.label }}">
      <button class="btn btn--light" type="submit" id="psiSubmit">{{ h.analyzer.button }}</button>
    </form>
    <p class="analyzer-status" id="psiStatus" role="status" aria-live="polite"></p>
    <div class="score-grid" id="psiResults" hidden></div>
    <p class="analyzer-note">{{ h.analyzer.disclaimer }}</p>
  </div>
</section>

<section class="section" id="faq">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{{ h.faqEyebrow }}</span>
      <h2>{{ h.faqH2 }}</h2>
    </div>
    <div class="faq reveal">
      {%- for f in h.faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container cta reveal">
    <span class="eyebrow">{{ t.bookShort }}</span>
    <h2>{{ h.ctaH2 }}</h2>
    <p>{{ h.ctaP }}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="{{ startUrl }}">{{ t.book }}</a>
      <a class="btn btn--outline-light" href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
</section>

{% endblock %}

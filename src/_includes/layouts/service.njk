{% extends "layouts/base.njk" %}
{%- set d = service[lang] -%}
{%- set selfUrl = ('/es/servicios/' + service.slugEs + '/') if lang == 'es' else ('/services/' + service.slug + '/') -%}

{% block head %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Service",
  "name":{{ d.name | dump | safe }},
  "description":{{ d.tagline | dump | safe }},
  "url":"{{ site.url }}{{ selfUrl }}",
  "provider":{"@type":"Organization","@id":"{{ site.url }}/#org","name":"Texas Digital Co.","url":"{{ site.url }}"},
  "availableLanguage":["en","es"]
}
</script>
{% endblock %}

{% block content %}

<section class="page-head">
  <div class="container">
    <p class="crumbs"><a href="{{ homeUrl }}">{{ 'Inicio' if lang == 'es' else 'Home' }}</a> / <a href="{{ homeUrl }}#services">{{ t.servicesLabel }}</a> / {{ d.name }}</p>
    <span class="eyebrow">{{ t.servicesLabel }}</span>
    <h1>{{ d.name }}</h1>
    <p class="lede">{{ d.tagline }}</p>
    <div class="price-badge"><b>{{ d.price }}</b><span>{{ d.priceNote }}</span></div>
    <div class="btn-row" style="margin-top:32px">
      <a class="btn btn--primary" href="{{ startUrl }}">{{ t.book }}</a>
      <a class="btn btn--outline-light" href="mailto:{{ site.email }}?subject={{ d.name | urlencode }}">{{ site.email }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <aside class="split-aside reveal">
      <h2 class="h-md" style="margin-bottom:20px">{{ t.whatsIncluded }}</h2>
      <ul class="includes">
        {%- for inc in d.includes %}
        <li>{{ icon("check") }}<span>{{ inc }}</span></li>
        {%- endfor %}
      </ul>
    </aside>

    <div class="prose reveal">
      <p class="lede" style="color:var(--ink);margin-bottom:44px">{{ d.intro }}</p>
      {%- for sec in d.sections %}
      <div class="detail">
        <h2>{{ sec.h }}</h2>
        <p>{{ sec.p }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--wash section--tight">
  <div class="container">
    <div class="sec-head reveal" style="margin-bottom:32px">
      <span class="eyebrow">{{ t.servicesLabel }}</span>
      <h2 class="h-md" style="font-size:1.5rem">{{ 'Los otros servicios' if lang == 'es' else 'The other services' }}</h2>
    </div>
    <div class="index reveal">
      {%- for s in services %}
      {%- if s.slug != service.slug %}
      {%- set o = s[lang] %}
      <a class="index-row" href="{{ '/es/servicios/' + s.slugEs + '/' if lang == 'es' else '/services/' + s.slug + '/' }}">
        <span class="index-num">{{ "0" + (loop.index | string) }}</span>
        <span class="index-name" style="font-size:1.375rem">{{ o.name }}</span>
        <span class="index-desc">{{ o.tagline }}</span>
        <span class="index-price">{{ o.price }}<small>{{ o.priceNote }}</small></span>
        <span class="index-arrow">{{ icon("arrow") }}</span>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container cta reveal">
    <span class="eyebrow">{{ t.bookShort }}</span>
    <h2>{{ home[lang].ctaH2 }}</h2>
    <p>{{ home[lang].ctaP }}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="{{ startUrl }}">{{ t.book }}</a>
      <a class="btn btn--outline-light" href="{{ homeUrl }}#pricing">{{ 'Ver precios' if lang == 'es' else 'See pricing' }}</a>
    </div>
  </div>
</section>

{% endblock %}

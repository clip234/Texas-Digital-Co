{%- from "partials/icons.njk" import icon -%}
{%- set t = ui[lang] -%}
{%- set navItems = nav[lang] -%}
{%- set homeUrl = "/es/" if lang == "es" else "/" -%}
{%- set startUrl = "/es/empezar/" if lang == "es" else "/start/" -%}
{%- set workUrl = "/es/proyectos/" if lang == "es" else "/work/" -%}
<!DOCTYPE html>
<html lang="{{ lang }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ metaTitle or title }}</title>
<meta name="description" content="{{ metaDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if altUrl %}<link rel="alternate" hreflang="{{ 'en' if lang == 'es' else 'es' }}" href="{{ site.url }}{{ altUrl }}">
<link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altUrl if lang == 'es' else page.url }}">{% endif %}

<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ metaTitle or title }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="{{ 'es_MX' if lang == 'es' else 'en_US' }}">
<meta name="twitter:card" content="summary_large_image">

{% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Gantari:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gantari:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/css/style.css">
<script>document.documentElement.classList.remove('no-js');</script>
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">{{ t.skip }}</a>

<header class="header" id="header">
  <div class="container header-inner">
    <a class="brand" href="{{ homeUrl }}">{{ icon("star", 21) }}<span>Texas Digital Co.</span></a>

    <nav class="nav" aria-label="{{ 'Principal' if lang == 'es' else 'Primary' }}">
      {%- for item in navItems %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>

    <div class="header-actions">
      {% if altUrl %}<a class="lang-link" href="{{ altUrl }}" lang="{{ 'en' if lang == 'es' else 'es' }}" aria-label="{{ t.langSwitchAria }}">{{ icon("globe", 15) }} {{ t.langSwitch }}</a>{% endif %}
      <a class="btn btn--primary btn--sm" href="{{ startUrl }}">{{ t.bookShort }}</a>
      <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="mobileNav" aria-label="{{ 'Menú' if lang == 'es' else 'Menu' }}"><span></span></button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav">
    <div class="container">
      {%- for item in navItems %}
      <a class="mobile-nav-item" href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
      <div class="mobile-nav-footer">
        <a class="btn btn--primary btn--block" href="{{ startUrl }}">{{ t.book }}</a>
        <a class="btn btn--ghost btn--block" href="mailto:{{ site.email }}">{{ site.email }}</a>
        {% if altUrl %}<a class="btn btn--ghost btn--block" href="{{ altUrl }}" lang="{{ 'en' if lang == 'es' else 'es' }}">{{ icon("globe", 15) }} {{ t.langSwitch }}</a>{% endif %}
      </div>
    </div>
  </div>
</header>

<main id="main">
{% block content %}{{ content | safe }}{% endblock %}
</main>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">{{ icon("star", 19) }} Texas Digital Co.</div>
        <p style="max-width:36ch">
          {% if lang == "es" %}Sitios web, automatización con IA, marca y Google Ads para negocios pequeños.{% else %}Websites, AI automation, branding, and Google Ads for small businesses.{% endif %}
        </p>
        <p style="margin-top:16px;font-size:.8125rem;color:#6F6F6F">{{ t.hours }}</p>
      </div>

      <div>
        <h4>{{ t.servicesLabel }}</h4>
        <ul>
          {%- for s in services %}
          <li><a href="{{ '/es/servicios/' + s.slugEs + '/' if lang == 'es' else '/services/' + s.slug + '/' }}">{{ s[lang].navName }}</a></li>
          {%- endfor %}
        </ul>
      </div>

      <div>
        <h4>{{ t.companyLabel }}</h4>
        <ul>
          <li><a href="{{ workUrl }}">{{ 'Proyectos' if lang == 'es' else 'Work' }}</a></li>
          <li><a href="{{ homeUrl }}#process">{{ 'Proceso' if lang == 'es' else 'Process' }}</a></li>
          <li><a href="{{ homeUrl }}#pricing">{{ 'Precios' if lang == 'es' else 'Pricing' }}</a></li>
          <li><a href="{{ homeUrl }}#faq">{{ 'Preguntas' if lang == 'es' else 'Questions' }}</a></li>
        </ul>
      </div>

      <div>
        <h4>{{ t.contactLabel }}</h4>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ startUrl }}">{{ t.bookShort }}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ year }} Texas Digital Co. {{ t.rights }}</span>
      <span>{% if lang == "es" %}Cada proyecto se puede manejar completamente por correo.{% else %}Every project can run entirely by email.{% endif %}</span>
    </div>
  </div>
</footer>

<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config","{{ site.ga }}");</script>
<script src="/assets/js/main.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>

{% extends "layouts/base.njk" %}
{%- set w = work[lang] -%}

{% block content %}

<section class="page-head">
  <div class="container">
    <span class="eyebrow">{{ w.eyebrow }}</span>
    <h1>{{ w.h1 }}</h1>
    <p class="lede">{{ w.lede }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {%- for p in work.projects %}
    {%- set pd = p[lang] %}
    <article class="project reveal">
      <div class="project-media">
        {%- if p.image %}
        <img src="{{ p.image }}" alt="{{ pd.name }}" loading="lazy" width="1200" height="750">
        {%- else %}
        <div class="project-fallback">
          <span class="pf-kick">{{ pd.kicker }}</span>
          <span class="pf-dom">{{ p.domain }}</span>
          <span class="pf-live"><span class="pf-dot"></span>{{ 'En vivo' if lang == 'es' else 'Live' }}</span>
        </div>
        {%- endif %}
      </div>
      <div>
        <span class="project-kicker">{{ pd.kicker }}</span>
        <h2>{{ pd.name }}</h2>
        <p class="project-summary">{{ pd.summary }}</p>
        <p style="margin-top:18px;color:var(--grey);font-size:.9375rem">{{ pd.detail }}</p>
        <ul class="project-points">
          {%- for pt in pd.points %}<li>{{ pt }}</li>{% endfor %}
        </ul>
        <div class="tags">
          {%- for tag in p.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="{{ p.url }}" target="_blank" rel="noopener">{{ pd.visit }}</a>
        </div>
      </div>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="section section--dark">
  <div class="container cta reveal">
    <span class="eyebrow">{{ t.bookShort }}</span>
    <h2>{{ home[lang].ctaH2 }}</h2>
    <p>{{ home[lang].ctaP }}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="{{ startUrl }}">{{ t.book }}</a>
      <a class="btn btn--outline-light" href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
</section>

{% endblock %}

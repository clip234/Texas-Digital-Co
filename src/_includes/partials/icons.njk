{% macro icon(name, size=20) %}
{%- if name == "check" -%}
<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7.5l3.2 3.2L12 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif name == "arrow" -%}
<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif name == "phone" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6.8 3.5H4.2c-.7 0-1.3.6-1.2 1.3.4 6 5.2 10.8 11.2 11.2.7.1 1.3-.5 1.3-1.2v-2.6c0-.6-.4-1.1-1-1.2l-2-.4c-.5-.1-1 .1-1.3.5l-.7 1c-2-1-3.6-2.6-4.6-4.6l1-.7c.4-.3.6-.8.5-1.3l-.4-2c-.1-.6-.6-1-1.2-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
{%- elif name == "mail" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M3 5.5l7 5 7-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif name == "pin" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 17s5.5-4.6 5.5-9a5.5 5.5 0 1 0-11 0c0 4.4 5.5 9 5.5 9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/></svg>
{%- elif name == "clock" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4"/><path d="M10 5.8V10l2.8 1.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif name == "globe" -%}
<svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 10h15M10 2.5c2 2.3 3 4.8 3 7.5s-1 5.2-3 7.5c-2-2.3-3-4.8-3-7.5s1-5.2 3-7.5z" stroke="currentColor" stroke-width="1.4"/></svg>
{%- elif name == "shield" -%}
<svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2.5l6 2.2v4.8c0 3.6-2.4 6.9-6 8-3.6-1.1-6-4.4-6-8V4.7l6-2.2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M7.5 10l1.8 1.8L13 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif name == "tag" -%}
<svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10.5V4a1 1 0 0 1 1-1h6.5l6 6-7 7-6-6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="6.8" cy="6.8" r="1.1" fill="currentColor"/></svg>
{%- elif name == "monitor" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 20.5h6M12 17v3.5M2.5 8h19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
{%- elif name == "bot" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="7.5" width="17" height="12" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V4M9 13h.01M15 13h.01M9.5 16.3c1.6.9 3.4.9 5 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="3" r="1.3" fill="currentColor"/></svg>
{%- elif name == "drone" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="8.5" y="9.5" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M9.5 9.5L6 6M14.5 9.5L18 6M9.5 14.5L6 18M14.5 14.5L18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="5" cy="5" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="5" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="5" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/></svg>
{%- elif name == "brand" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 3.5v17M3.5 12h17" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
{%- elif name == "print" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 9V3.5h10V9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><rect x="3.5" y="9" width="17" height="7" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 14h10v6.5H7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
{%- elif name == "target" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/></svg>
{%- elif name == "star" -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2l3.2 9.6L29 12l-7.6 5.9 2.8 9.7L16 21.8 7.8 27.6l2.8-9.7L3 12l9.8-.4L16 2z" fill="currentColor"/></svg>
{%- endif -%}
{% endmacro %}
